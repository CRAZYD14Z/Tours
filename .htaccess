<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

Options -MultiViews
RewriteEngine On
RewriteBase /tours/

RewriteRule ^api/tours/?$ api/index.php?resource=tours [L,QSA]
RewriteRule ^api/tour/([0-9]+)/?$ api/index.php?resource=tour&id=$1 [L,QSA]
RewriteRule ^api/company/([0-9]+)/?$ api/index.php?resource=company&id=$1 [L,QSA]
RewriteRule ^api/departures/([0-9]+)/?$ api/index.php?resource=departures&tour_id=$1 [L,QSA]
RewriteRule ^api/seats/([0-9]+)/?$ api/index.php?resource=seats&departure_id=$1 [L,QSA]
RewriteRule ^api/vehicles/?$ api/index.php?resource=vehicles [L,QSA]
RewriteRule ^bus/index\.php$ pages/bus/index.php [L,QSA]
RewriteRule ^bus/?$ pages/bus/index.php [L,QSA]
RewriteRule ^compania-de-tours/([0-9]+)/?$ pages/compania/index.php?id=$1 [L,QSA]
RewriteRule ^compania-de-tours/([^/]+)/([0-9]+)/?$ pages/compania/index.php?id=$2&company_slug=$1 [L,QSA]
RewriteRule ^compania/([0-9]+)/?$ pages/compania/index.php?id=$1 [L,QSA]
RewriteRule ^([^/]+)/([^/]+)/([0-9]+)/?$ pages/detalle/index.php?tour_id=$3&company_slug=$1&tour_slug=$2 [L,QSA]
RewriteRule ^tour/([0-9]+)/?$ pages/detalle/index.php?tour_id=$1 [L,QSA]

